#!/usr/bin/env bash

# usage: ./sync-summary
#
# mdBook only builds pages that are listed in src/SUMMARY.md. This script keeps
# an '# Unlisted' section at the end of SUMMARY.md in sync with the markdown
# files in src/: every .md file that is not already listed somewhere above the
# marker gets appended to it.
#
# theme/css/chrome.css hides that section from the sidebar, so those pages are
# built and reachable by URL, but do not show up in the navigation. Run by
# ./build, ./watch and ./publish; there is no need to call it by hand.

set -euo pipefail
export LC_ALL=C

root="$(cd "$(dirname "$0")" && pwd)"
src="$root/src"
summary="$src/SUMMARY.md"
marker="# Unlisted"

tmp="${TMPDIR:-/tmp}"
listed="$(mktemp "$tmp/sync-summary.XXXXXX")"
pages="$(mktemp "$tmp/sync-summary.XXXXXX")"
new="$(mktemp "$tmp/sync-summary.XXXXXX")"
trap 'rm -f "$listed" "$pages" "$new"' EXIT

# everything above the marker is maintained by hand and wins
awk -v marker="$marker" '
    $0 == marker            { exit }
    /^[[:space:]]*$/        { blanks = blanks $0 "\n"; next }
                            { printf "%s", blanks; blanks = ""; print }
' "$summary" > "$new"

# the pages it already links to, as paths relative to src/
grep -o '](/*[^)]*\.md)' "$new" \
    | sed 's|^](/*||; s|)$||' \
    | sort -u > "$listed"

# every page in src/, minus SUMMARY.md itself
(cd "$src" && find . -type f -name '*.md') \
    | sed 's|^\./||' \
    | grep -v '^SUMMARY\.md$' \
    | sort > "$pages"

cat >> "$new" <<EOF

$marker

<!-- Generated by ./sync-summary, do not edit by hand. Everything below this
     heading is built and reachable by direct link, but hidden from the sidebar
     (see the rule at the bottom of theme/css/chrome.css). To give a page a spot
     in the navigation, move it into the list above; it then disappears here on
     the next build. -->
EOF

count=0
while IFS= read -r page; do
    # the page's first level-1 heading, or its file name
    title="$(grep -m1 '^# ' "$src/$page" | sed 's/^# *//; s/[[:space:]]*$//' || true)"
    if [ -z "$title" ]; then
        title="$(basename "$page" .md)"
    fi
    if [ "$count" -eq 0 ]; then
        printf '\n' >> "$new"
    fi
    printf -- '- [%s](%s)\n' "$title" "$page" >> "$new"
    count=$((count + 1))
done < <(comm -23 "$pages" "$listed")

# only touch the file on a real change, so `mdbook serve` does not rebuild
if ! cmp -s "$new" "$summary"; then
    cat "$new" > "$summary"
    echo "sync-summary: $count unlisted page(s)" >&2
fi
